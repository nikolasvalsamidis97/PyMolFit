include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
include LICENSE
include README.md
include THIRD_PARTY_NOTICES.md
recursive-include docs *.md *.ipynb *.py *.png
include docs/user_guide/data/*.fits
include docs/user_guide/data/beta_pic_*.txt
recursive-include tools *.py
recursive-include paper_validation *.py
recursive-include tests *.py *.npz
recursive-exclude docs/user_guide/outputs *
recursive-exclude docs/user_guide/regions *
prune docs/user_guide/.ipynb_checkpoints
global-exclude __pycache__ *.py[cod] .DS_Store
